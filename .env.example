# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/peedika?retryWrites=true&w=majority

# JWT Secret for authentication (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Environment
NODE_ENV=production

# Port (Render sets this automatically)
PORT=5000

# Google Gemini API Key (for AI copilot features)
GEMINI_API_KEY=your-gemini-api-key

# Unsplash API Key (optional - for product image scraping)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key
